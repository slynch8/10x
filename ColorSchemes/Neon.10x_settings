# Format: <SettingName>: <Settingvalue>
# Setting name must appear at start of line and there must be whitespace after the colon.

# The main UI colour
UI.UI:                                            8, 6, 14

# Text colour for the main UI
UI.UI Text:                                       236, 248, 255

# Edit box text selections
UI.UI Selected Text:                              220, 200, 230

# Selected items (in list boxes etc)
UI.UI Selected Item:                              120, 70, 150

# Colour of the main drop down menu
UI.Menu:                                          default

# Colour of menu items as the mouse moves over
UI.Menu (highlighted):                            default

# Colour of menu items that are selected (showing sub menus)
UI.Menu (selected):                               default

# App border when app is active
UI.App Border (active):                           255, 80, 180

# App border when app is inactive
UI.App Border (inactive):                         70, 60, 75

# Colour of the tab for the currently active panel
UI.Panels.Active Tab:                             120, 30, 85

# Text colour for active tabs
UI.Panels.Active Tab Text:                        248, 240, 255

# Text colour for inactive tabs
UI.Panels.Inactive Tab Text:                      170, 160, 180

# Colour of tabs for inactive panels
UI.Panels.Inactive Tab:                           40, 36, 48

# Colour of the scrollbar background
UI.Panels.Scrollbar Background:                   default

# Colour of the scrollbar bar
UI.Panels.Scrollbar Bar:                          64, 54, 72

# Colour of the scrollbar bar when the mouse is hovering over
UI.Panels.Scrollbar Bar (hover):                  100, 80, 120

# Colour of the scrollbar bar when being dragged
UI.Panels.Scrollbar Bar (drag):                   140, 110, 170

# Colour of the map-scrollbar bar
UI.Panels.MapScrollbar Bar:                       default

# 10x output error
UI.10xOutputError:                                255, 90, 110

# 10x output warning
UI.10xOutputWarning:                              255, 200, 90

# Highlight for search results list
UI.SearchHighlight:                               default

# 10x logo background
UI.LogoBack:                                      default

# 10x logo foreground
UI.LogoFore:                                      default

